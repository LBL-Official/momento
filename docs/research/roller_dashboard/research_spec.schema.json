{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momento.local/roller/research_spec_v0.schema.json",
  "title": "ROLLER Research Spec v0",
  "description": "Universal Research Object contract. Permanent query format. Natural language is not. FIRST80 is one instance — not the schema boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "universe",
    "anchor",
    "information_regime",
    "execution_interpretation",
    "definition_versions",
    "caveats"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "research_spec_v0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "research_object_id": {
          "type": "string",
          "description": "Optional precomputed hash; adapters may recompute"
        }
      }
    },
    "universe": {
      "type": "string",
      "description": "Organizational boundary. First: BBALL1.",
      "examples": ["BBALL1"]
    },
    "population_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leagues": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["NBA", "WNBA", "NCAAB"]
          }
        },
        "default_structural_slices": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Q1", "Q2", "Q3", "Q4", "H1_1", "H1_2", "H2_1", "H2_2", "ASKED_SIX"]
          },
          "description": "ASKED_SIX expands to Q2∪Q3∪H1_2∪H2_1 per sport rules"
        },
        "p5_vs_p5_only": { "type": "boolean" },
        "locked_population_id": {
          "type": ["string", "null"],
          "description": "Immutable population hash when set"
        },
        "selection": {
          "type": "string",
          "enum": ["all_matching", "locked_population", "explicit_ids"]
        },
        "seasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Warehouse season keys (e.g. 2025-2026, 2025). STRUCTURAL until an authoritative population route applies them."
        },
        "season_months": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "description": "Calendar months YYYY-MM within selected seasons. STRUCTURAL until applied by an authoritative route."
        },
        "season_weeks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"
          },
          "description": "ISO weeks YYYY-Www. STRUCTURAL until applied by an authoritative route."
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "type": "string",
          "description": "Concept id from vocabulary, e.g. FIRST_PRICE_TOUCH, OBSERVATION_TIME, PRICE_MOVE",
          "examples": ["FIRST_PRICE_TOUCH", "OBSERVATION_TIME", "PRICE_MOVE"]
        },
        "price_e4": {
          "type": ["integer", "null"],
          "description": "Integer E4. Required for FIRST_PRICE_TOUCH. Null only when event does not use price."
        },
        "price_field": {
          "type": "string",
          "enum": ["yes_bid_close", "yes_ask_close", "yes_bid_low", "yes_bid_high"]
        },
        "direction": {
          "type": "string",
          "enum": ["UP", "DOWN", "ABS", "UNRESOLVED"]
        },
        "magnitude_e4": {
          "type": ["integer", "null"],
          "description": "Absolute move in E4. Must not be invented from 'big'/'sharp'."
        },
        "requires_seen_below": {
          "type": "boolean",
          "description": "FIRST80-style: prior tradable close below threshold"
        },
        "unresolved_parameters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "If non-empty, spec must not run"
        }
      }
    },
    "information_regime": {
      "type": "string",
      "enum": [
        "CANDLE_1M",
        "POINT_IN_TIME",
        "FROZEN_ARTIFACT",
        "FULL_HISTORY",
        "BOOK_SNAPSHOT",
        "UNRESOLVED"
      ]
    },
    "information_set": {
      "type": "string",
      "enum": ["I_t_anchor", "O_t", "L_forward", "FROZEN", "UNRESOLVED"],
      "description": "I(t_anchor) vs O_t vs forward labels"
    },
    "state_filters": {
      "$ref": "#/$defs/boolean_expr"
    },
    "path_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/path_condition" }
    },
    "terminal_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/terminal_condition" }
    },
    "measurement_requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/measurement_request" }
    },
    "sample_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of": { "type": ["string", "null"], "description": "ISO-8601 UTC or date" },
        "end_of_day": { "type": "boolean" },
        "data_cutoff": { "type": ["string", "null"] },
        "train": { "$ref": "#/$defs/date_range" },
        "validation": { "$ref": "#/$defs/date_range" },
        "forward": { "$ref": "#/$defs/date_range" },
        "split_binding": {
          "type": "string",
          "description": "e.g. warehouse_frozen_v1.dataset_split"
        }
      }
    },
    "definition_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Explicit engine bindings. Example: FIRST80=warehouse_frozen_v1"
    },
    "dataset_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "execution_interpretation": {
      "type": "string",
      "enum": [
        "OBSERVABLE_PATH_ONLY",
        "CANDLE_PATH_PROXY",
        "EXECUTION_VALIDATED",
        "UNRESOLVED"
      ]
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Required disclosures; at least one"
    },
    "economic_layer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Optional; Phase 7. Absent means no economic interpretation.",
      "properties": {
        "fee_binding": { "type": "string" },
        "ev_binding": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    },
    "portfolio_layer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Optional consumer; Phase 7. Not the core research engine.",
      "properties": {
        "binding": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ephemeral", "saved", "frozen", "locked_population"]
        },
        "saved_id": { "type": ["string", "null"] },
        "frozen_id": { "type": ["string", "null"] },
        "population_hash": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "boolean_expr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "type": "string", "enum": ["AND", "OR", "NOT", "ATOM"] },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/boolean_expr" }
        },
        "field": { "type": "string" },
        "operator": {
          "type": "string",
          "enum": ["eq", "neq", "lt", "lte", "gt", "gte", "in", "between", "exists"]
        },
        "value": true
      }
    },
    "path_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "NEVER_CLOSE_LE",
            "EVER_CLOSE_LE",
            "EVER_CLOSE_GE",
            "SURVIVE_THEN_TOUCH",
            "MAE_GT",
            "FORWARD_RESPONSE",
            "CUSTOM_BINDING",
            "UNRESOLVED"
          ]
        },
        "price_e4": { "type": ["integer", "null"] },
        "survive_price_e4": { "type": ["integer", "null"] },
        "touch_price_e4": { "type": ["integer", "null"] },
        "binding": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "terminal_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "KALSHI_YES",
            "KALSHI_NO",
            "UNRESTRICTED",
            "CUSTOM_BINDING",
            "UNRESOLVED"
          ]
        },
        "binding": { "type": "string" }
      }
    },
    "measurement_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "e.g. kalshi_yes_rate, t40_rate, fundamental, market_fundamental_basis, market_delta_1m"
        },
        "binding": { "type": "string" },
        "params": { "type": "object" },
        "not_edge": {
          "type": "boolean",
          "const": true,
          "description": "Measurements are never silently labeled edge"
        }
      }
    }
  }
}
