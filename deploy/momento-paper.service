[Unit]
Description=Momento paper trading engine (live trading not implemented)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=momento
Group=momento
WorkingDirectory=/var/lib/momento
Environment=MOMENTO_CONFIG=/var/lib/momento/config/paper.toml
Environment=MOMENTO_STATE_DIR=/var/lib/momento/state
ExecStart=/usr/local/bin/momento-trading-engine
Restart=always
RestartSec=2
TimeoutStopSec=15
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/momento/state
StandardOutput=journal
StandardError=journal
SyslogIdentifier=momento-paper

[Install]
WantedBy=multi-user.target
