[Unit]
Description=Momento MLB live trading engine (production Kalshi)
After=network-online.target
Wants=network-online.target
Conflicts=momento-paper.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=momento
Group=momento
WorkingDirectory=/var/lib/momento
Environment=MOMENTO_CONFIG=/var/lib/momento/config/live.toml
Environment=MOMENTO_STATE_DIR=/var/lib/momento/state
Environment=MOMENTO_KALSHI_ENV=production
Environment=MOMENTO_KALSHI_SECRET_FILE=/dev/shm/momento-kalshi-live.json
Environment=MOMENTO_FACTORY_UNIT=1
Environment=AWS_DEFAULT_REGION=us-east-1
Environment=AWS_REGION=us-east-1
Environment=MOMENTO_AWS_REGION=us-east-1
ExecStartPre=/usr/local/libexec/m10-fetch-secret.sh
ExecStart=/usr/local/bin/momento-trading-engine
ExecStopPost=/bin/rm -f /dev/shm/momento-kalshi-live.json
Restart=always
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=15
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/momento/state
StandardOutput=journal
StandardError=journal
SyslogIdentifier=momento-live

[Install]
WantedBy=multi-user.target
