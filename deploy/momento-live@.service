[Unit]
Description=Momento isolated ITI live engine for Jump bot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=momento
Group=momento
WorkingDirectory=/var/lib/momento
Environment=MOMENTO_CONFIG=/var/lib/momento/live/%i/live.toml
Environment=MOMENTO_STATE_DIR=/var/lib/momento/live/%i/state
Environment=MOMENTO_KALSHI_ENV=production
Environment=MOMENTO_KALSHI_SECRET_FILE=/dev/shm/momento-kalshi-live-%i.json
Environment=MOMENTO_LIVE_INSTANCE=%i
Environment=MOMENTO_FACTORY_UNIT=0
Environment=AWS_DEFAULT_REGION=us-east-1
Environment=AWS_REGION=us-east-1
Environment=MOMENTO_AWS_REGION=us-east-1
ExecStartPre=/usr/local/libexec/m-iti-live-fetch-secret.sh
ExecStart=/usr/local/bin/momento-trading-engine
ExecStopPost=/bin/rm -f /dev/shm/momento-kalshi-live-%i.json
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=15
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/momento/live/%i
StandardOutput=journal
StandardError=journal
SyslogIdentifier=momento-live-%i

[Install]
WantedBy=multi-user.target
