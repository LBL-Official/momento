# Kalshi demo/sandbox only. Never commit values. Never set this to live.
MOMENTO_KALSHI_ENV=demo
MOMENTO_KALSHI_API_KEY_ID=
MOMENTO_KALSHI_PRIVATE_KEY_PATH=

# M9 production (ARN/path only; never put PEM or key IDs here).
# MOMENTO_KALSHI_ENV=production
# MOMENTO_KALSHI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:momento/kalshi/production
# MOMENTO_KALSHI_SECRET_FILE=

# Research / backtest (optional overrides)
# MOMENTO_RESEARCH_DATA_DIR=Backtesting Suite/Data
# MOMENTO_BACKTEST_SUITE_DIR=Backtesting Suite
# MOMENTO_BACKTEST_INPUT_SHEET_ID=1KyPqwIz737G2hE5I0A7kkocbRq9-yZPSoro9kGAykjE
# MOMENTO_BACKTEST_RESULTS_SHEET_ID=1DtWuNNstH48UdHl3jq2icXxJVfTVM_O3FIdGg3IZ72E
# MOMENTO_BACKTEST_DRIVE_FOLDER_ID=1WKopI1xCPIHQ7yuPs3X10M5EFVhvvZlL

